# Only policy documentation is tracked in system/secrets/.
system/secrets/*
!system/secrets/README.md
# Disposable data.
system/temp/*
!system/temp/README.md
# Credential/state formats do not belong in knowledge Git.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.session
*.session-journal
# Local app state.
.DS_Store
.cache/
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/*/data.json
